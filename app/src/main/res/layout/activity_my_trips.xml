    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="16dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:layout_marginHorizontal="18dp"
            >
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/home"
                app:tint="#9E9E9E"/> </LinearLayout>

        <LinearLayout
            android:id="@+id/navBookmark"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center"
            >
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bookmark"
                app:tint="#9E9E9E"/> </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/nav_item_selected_bg">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_calendar"
                app:tint="#000000"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:layout_marginHorizontal="18dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_chat"
                app:tint="#9E9E9E"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navNotification"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:layout_marginHorizontal="18dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_ring"
                app:tint="#9E9E9E"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyTrips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomNav"
        android:paddingTop="16dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_calendar"
            app:tint="#DDDDDD"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có chuyến đi nào"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#999999"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnCreateTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="+ Tạo chuyến đi mới"
        android:textColor="@android:color/white"
        android:backgroundTint="#2196F3"
        app:icon="@drawable/ic_calendar"
        app:iconTint="@android:color/white"/>

</RelativeLayout>