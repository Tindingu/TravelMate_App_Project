<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 🔹 HEADER NẰM TRÊN CÙNG -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:rotation="270"
            android:src="@drawable/ic_chevron_up" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivSetting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_ring" />
    </LinearLayout>

    <!-- 🔹 SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="93dp"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ẢNH -->
<!--            <ImageView-->
<!--                android:id="@+id/ivPlaceImage"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="220dp"-->
<!--                android:scaleType="centerCrop"-->
<!--                android:src="@drawable/sample_place" />-->
            <!-- MAP -->
            <fragment
                android:id="@+id/placeMap"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                />

            <!-- TÊN -->
            <TextView
                android:id="@+id/tvPlaceName"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- ĐỊA CHỈ -->
            <TextView
                android:id="@+id/tvPlaceAddress"
                android:textSize="15sp"
                android:textColor="#444"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- ⭐ RATING QUÁN -->
            <TextView
                android:id="@+id/tvPlaceRating"
                android:text="⭐ 4.5"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- ⭐ USER RATING -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Đánh giá của bạn:"
                    android:textSize="15sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RatingBar
                    android:id="@+id/ratingUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1" />
            </LinearLayout>

            <!-- DANH SÁCH COMMENT -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp" />

            <!-- KHUNG COMMENT -->
            <LinearLayout
                android:id="@+id/commentInputBox"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- PREVIEW NHIỀU ẢNH -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPreviewImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone" />

                <!-- INPUT -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etComment"
                        android:hint="Viết bình luận..."
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="12dp" />

                    <ImageView
                        android:id="@+id/btnAddImage"
                        android:src="@drawable/icon_add_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="6dp" />

                    <ImageView
                        android:id="@+id/btnSendComment"
                        android:src="@drawable/icon_send"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="6dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddToTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_calendar"
        app:backgroundTint="#FF9800"
        app:tint="@android:color/white"
        android:contentDescription="Add to trip" />
</FrameLayout>
