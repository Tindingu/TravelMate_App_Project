            <LinearLayout
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/icNotification"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_ring" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ================= DIM BACKGROUND ================= -->
    <View
        android:id="@+id/dimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:alpha="0" />


    <!-- ================= SLIDE FILTER PANEL ================= -->

    <LinearLayout
        android:id="@+id/filterPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:translationX="-300dp">

        <!-- 🔹 TIÊU ĐỀ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc tìm kiếm"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="14dp" />

        <!-- 🔹 LOẠI ĐỊA ĐIỂM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loại địa điểm"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>

        <CheckBox
            android:id="@+id/cbRestaurant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhà hàng" />

        <CheckBox
            android:id="@+id/cbCafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quán cà phê" />

        <CheckBox
            android:id="@+id/cbHotel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khách sạn" />

        <CheckBox
            android:id="@+id/cbEntertainment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khu vui chơi" />
        <CheckBox
            android:id="@+id/cbBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quan Bar" />
        <!-- 🔹 KHOẢNG CÁCH -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khoảng cách"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="18dp" />

        <SeekBar
            android:id="@+id/seekDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5000"
            android:progress="1000"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvDistanceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 km"
            android:textSize="13sp"
            android:textColor="#666666"
            android:paddingTop="6dp" />

        <!-- 🔹 ĐÁNH GIÁ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đánh giá"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="18dp" />

        <SeekBar
            android:id="@+id/seekRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="3"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvRatingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 sao"
            android:textSize="13sp"
            android:textColor="#666666"
            android:paddingTop="6dp" />
        <!-- 🔹 Số lượng kết quả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số lượng kết quả"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="18dp" />

        <SeekBar
            android:id="@+id/seekSoLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="15"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvSoLuong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 địa điểm"
            android:textSize="13sp"
            android:textColor="#666666"
            android:paddingTop="6dp" />
        <!-- ================= Buttons ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnResetFilter"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#000"
                android:backgroundTint="#EEEEEE"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Áp dụng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
