<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingVertical="4dp">

    <!-- Sender Avatar -->
    <ImageView
        android:id="@+id/ivSenderAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/avatar_circle_bg"
        android:src="@drawable/avttest"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="56dp"
        android:maxWidth="280dp">

        <!-- Sender Name -->
        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="2dp" />

        <!-- Reply Indicator (if replying) -->
        <LinearLayout
            android:id="@+id/layoutReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_reply_indicator"
            android:padding="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#FF6B35" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvReplyToName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35" />

                <TextView
                    android:id="@+id/tvReplyToContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original message"
                    android:textSize="11sp"
                    android:textColor="#666666"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Message Bubble -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_message_received"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9h sáng nhé!"
                android:textSize="14sp"
                android:textColor="#333333" />

            <!-- Reactions Row -->
            <LinearLayout
                android:id="@+id/layoutReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ 2  👍 1"
                    android:textSize="10sp"
                    android:textColor="#666666" />
            </LinearLayout>
        </LinearLayout>

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19:08"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
